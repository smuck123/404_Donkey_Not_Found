# Zabbix credentials. Keep real values only in .env on the server.
ZABBIX_URL=https://zabbix.example.invalid/
ZABBIX_TOKEN=replace-with-zabbix-api-token
ZABBIX_TRAFFIC_ITEM_KEY=fortigate_summary.sh
FORTIGATE_ZABBIX_HOST=himabot

# FortiGate read-only REST API account. Never use a super-admin token.
FORTIGATE_URL=https://192.168.0.1
FORTIGATE_TOKEN=replace-with-read-only-fortigate-token
FORTIGATE_VDOM=root
FORTIGATE_VERIFY_SSL=true
FORTIGATE_TRAFFIC_PATH=/api/v2/monitor/firewall/session

# Optional OpenClaw profile. Generate a long random token on the server.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1
OPENCLAW_GATEWAY_TOKEN=replace-with-random-token
OLLAMA_API_KEY=ollama-local
TZ=Europe/Helsinki
